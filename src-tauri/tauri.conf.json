{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/"
  },
  "productName": "VMK Studio",
  "mainBinaryName": "vmk-studio",
  "version": "0.4.0",
  "identifier": "dev.vmk.studio",
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright VMK Studio Contributors and The ZMK Contributors",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Custom-firmware-aware fork of ZMK Studio with visual keymap editing, devicetree firmware tuning, custom behaviour protection, and half-guarded UF2 flashing.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": [],
    "shortDescription": "Custom-firmware-aware ZMK Studio fork",
    "targets": "all",
    "windows": {}
  },
  "plugins": {
    "cli": {
      "description": "Tauri CLI Plugin Example",
      "args": [
        {
          "name": "serial-port",
          "takesValue": true,
          "description": "Specific serial port to connect to"
        }
      ]
    }
  },
  "app": {
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 840,
        "resizable": true,
        "title": "VMK Studio",
        "width": 1280
      }
    ]
  }
}
